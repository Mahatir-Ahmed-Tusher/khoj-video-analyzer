# ==============================================================================
# Khoj Video Analyzer - Environment Configuration Example
# Duplicate this file to .env and configure with your credentials
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0

# Speech-to-Text (Faster-Whisper Single Active Slot)
WHISPER_MODEL_SIZE=ammaraldirawi/faster-whisper-small-bn-int8
WHISPER_MODEL_BN=ammaraldirawi/faster-whisper-small-bn-int8
WHISPER_MODEL_HI=ammaraldirawi/faster-whisper-small-hi-int8
WHISPER_MODEL_EN=Systran/faster-whisper-tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=default
WHISPER_CPU_THREADS=2
WHISPER_DOWNLOAD_ROOT=./hf_cache

# Bengali Post-Processing (Primary: Google Gemini, Fallback: OpenRouter Nemotron)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=your_openrouter_api_key_here
NEMOTRON_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NEMOTRON_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
ENABLE_BENGALI_REFINER=true

# Optical Character Recognition (Dedicated Cloudflare Bangla Neural OCR Gateway)
BANGLA_OCR_API_URL=https://bangla-ocr-api.mahatirtusher.workers.dev/ocr
OCR_LANGUAGES=ben+eng
FRAME_SAMPLE_INTERVAL_SECONDS=2.0
MAX_FRAMES_TO_OCR=8

# Video Processing & Guardrails
MAX_VIDEO_DURATION_SECONDS=900
MAX_UPLOAD_SIZE_MB=50

# Ephemeral Cloudflare R2 Media Buffer (Optional, auto-purged after analysis)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=khoj-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
AUTO_DELETE_R2_MEDIA=true
